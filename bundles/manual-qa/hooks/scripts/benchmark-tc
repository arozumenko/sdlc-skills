#!/usr/bin/env bash
# PostToolUse hook — fires after every Agent tool call.
# On the first call in a session it captures a ccusage pre-snapshot and
# writes a state file; subsequent calls just append the TC trace line.
#
# Files are scoped by session_id (2026-07-22 fix) — see benchmark-session-start
# for why. This is the one script in the chain that ALSO needs to forward its
# full stdin payload untouched to benchmark-tc-hook.mjs (content[], usage,
# tool_input.subagent_type, etc.) — so we capture stdin ONCE into `$payload`,
# parse session_id out of a piped copy of it, and explicitly replay the same
# captured variable into benchmark-tc-hook.mjs at the end (see bottom) instead
# of relying on stdin pass-through, which capturing it here would otherwise
# starve.
set -euo pipefail

PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"
# Bundle-installed scripts (build-run-metrics.mjs, benchmark-tc-hook.mjs) live
# next to this script, not at <project>/scripts/ — resolve self-relatively so
# this works regardless of cwd (run-hook.cmd always sets $0 to the full path).
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
STATE_DIR="${PROJECT_DIR}/.claude"

payload="$(cat 2>/dev/null || true)"
sid="$(printf '%s' "$payload" | node -e "
  const c=[];process.stdin.on('data',d=>c.push(d));
  process.stdin.on('end',()=>{
    try{const p=JSON.parse(Buffer.concat(c).toString());
    console.log(p.session_id||p.sessionId||'');}catch{}process.exit(0);
  });" 2>/dev/null || true)"
sid="${sid//[^A-Za-z0-9._-]/}"
SID_SUFFIX="${sid:+-$sid}"

STATE_FILE="${STATE_DIR}/benchmark-state${SID_SUFFIX}.json"
TRACE_FILE="${STATE_DIR}/benchmark-tc-trace${SID_SUFFIX}.jsonl"
PRE_FILE="${STATE_DIR}/benchmark-pre${SID_SUFFIX}.json"
SESSION_PRE_FILE="${STATE_DIR}/benchmark-session-pre${SID_SUFFIX}.json"

# MULTI-BUNDLE GUARD — same rule as benchmark-preflight (see its comment):
# another bundle's dispatch must not init state here via the fallback below,
# or benchmark-stop will fabricate a metrics file for a session that was
# never a manual-qa run. Empty subagent_type fails open (older builds).
MANUAL_QA_ROSTER='^(app-profiler|test-sizer|test-author|test-run-lead|test-runner|test-reporter)$'
agent_type="$(printf '%s' "$payload" | node -e "
  const c=[];process.stdin.on('data',d=>c.push(d));
  process.stdin.on('end',()=>{
    try{const p=JSON.parse(Buffer.concat(c).toString());
    console.log(p.tool_input?.subagent_type||'');}catch{}process.exit(0);
  });" 2>/dev/null || true)"
if [ ! -f "$STATE_FILE" ] && [ -n "$agent_type" ] && ! printf '%s' "$agent_type" | grep -Eq "$MANUAL_QA_ROSTER"; then
  exit 0
fi

# Fallback init — runs only if benchmark-preflight (PreToolUse hook) didn't fire
# (e.g., hook not yet wired or first run after upgrade).
if [ ! -f "$STATE_FILE" ]; then
  mkdir -p "$STATE_DIR"
  : > "$TRACE_FILE"
  first_dispatch_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  # Same session-start-snapshot preference as benchmark-preflight — see there
  # for why.
  if [ -f "$SESSION_PRE_FILE" ]; then
    cp "$SESSION_PRE_FILE" "$PRE_FILE"
  else
    ccusage session --json > "$PRE_FILE" 2>/dev/null \
      || printf '{}' > "$PRE_FILE"
  fi
  printf '{"first_dispatch_at":"%s","pre_file":"%s","trace_file":"%s"}\n' \
    "$first_dispatch_at" "$PRE_FILE" "$TRACE_FILE" > "$STATE_FILE"
fi

# Replay the captured payload (stdin was already consumed above to read
# session_id) into benchmark-tc-hook.mjs's own stdin, and append to tc-trace.jsonl.
printf '%s' "$payload" | node "${HOOK_DIR}/benchmark-tc-hook.mjs" "$TRACE_FILE"
